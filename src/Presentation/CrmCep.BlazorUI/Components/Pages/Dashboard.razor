@page "/"
@inject ICustomerApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Tổng Quan CRM - CEP Microfinance</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <div class="d-flex flex-column align-center justify-center py-12">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" Size="Size.Large" Class="mb-4" />
            <MudText Typo="Typo.h5" Class="mb-2">Bạn cần đăng nhập để truy cập hệ thống</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">Vui lòng đăng nhập với tài khoản quản trị để xem bảng tổng quan.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login" Href="/login">
                Đăng Nhập Ngay
            </MudButton>
        </div>
    </NotAuthorized>
    <Authorized>
        <div class="d-flex justify-space-between align-center mb-4">
            <div>
                <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Primary">
                    TỔNG QUAN HỆ THỐNG TÍN DỤNG VI MÔ CEP
                </MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Báo cáo tổng hợp tình hình hồ sơ khách hàng, phân loại đối tượng và trạng thái hoạt động.
                </MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PeopleAlt" Href="/customers">
                Quản Lý Khách Hàng
            </MudButton>
        </div>

        <!-- 1. 4 Thẻ KPI Chỉ Số Nhanh -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="2" Class="pa-4 d-flex justify-space-between align-center" Style="border-left: 5px solid #00695C; border-radius: 8px;">
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary font-weight-bold">TỔNG KHÁCH HÀNG</MudText>
                        <MudText Typo="Typo.h4" Class="font-weight-bold mt-1">@(_stats?.TotalCustomers ?? 0)</MudText>
                        <MudText Typo="Typo.caption" Class="text-success font-weight-bold">100% Hồ sơ vi mô</MudText>
                    </div>
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Medium" />
                    </MudAvatar>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="2" Class="pa-4 d-flex justify-space-between align-center" Style="border-left: 5px solid #2E7D32; border-radius: 8px;">
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary font-weight-bold">ĐANG HOẠT ĐỘNG</MudText>
                        <MudText Typo="Typo.h4" Class="font-weight-bold mt-1 text-success">@(_stats?.ActiveCustomers ?? 0)</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Đủ điều kiện vay vốn</MudText>
                    </div>
                    <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Medium" />
                    </MudAvatar>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="2" Class="pa-4 d-flex justify-space-between align-center" Style="border-left: 5px solid #F57C00; border-radius: 8px;">
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary font-weight-bold">TẠM NGƯNG / KHÓA</MudText>
                        <MudText Typo="Typo.h4" Class="font-weight-bold mt-1 text-warning">@((_stats?.SuspendedCustomers ?? 0) + (_stats?.LockedCustomers ?? 0))</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Cần xác minh thêm</MudText>
                    </div>
                    <MudAvatar Color="Color.Warning" Variant="Variant.Filled" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.PauseCircle" Size="Size.Medium" />
                    </MudAvatar>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="2" Class="pa-4 d-flex justify-space-between align-center" Style="border-left: 5px solid #0288D1; border-radius: 8px;">
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary font-weight-bold">MỚI TRONG THÁNG</MudText>
                        <MudText Typo="Typo.h4" Class="font-weight-bold mt-1 text-info">@(_stats?.NewCustomersThisMonth ?? 0)</MudText>
                        <MudText Typo="Typo.caption" Class="text-info font-weight-bold">Tăng trưởng tháng @DateTime.Now.Month</MudText>
                    </div>
                    <MudAvatar Color="Color.Info" Variant="Variant.Filled" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Medium" />
                    </MudAvatar>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- 2. Thống Kê Phân Loại Đối Tượng & Trạng Thái Hoạt Động -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" md="6">
                <MudCard Elevation="2" Style="border-radius: 8px; height: 100%;">
                    <MudCardHeader>
                        <CardHeaderAvatar>
                            <MudAvatar Color="Color.Primary" Size="Size.Small"><MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" /></MudAvatar>
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Class="font-weight-bold">Cơ Cấu Đối Tượng Khách Hàng CEP</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Tỷ trọng các nhóm đối tượng vi mô đang tiếp cận vốn</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="pt-0">
                        <div class="mb-4">
                            <div class="d-flex justify-space-between align-center mb-1">
                                <span class="d-flex align-center">
                                    <MudIcon Icon="@Icons.Material.Filled.Engineering" Color="Color.Primary" Size="Size.Small" Class="mr-2" />
                                    <strong>Công nhân</strong>
                                </span>
                                <span><strong>@_workerCount</strong> hồ sơ (@_workerPct.ToString("0.0")%)</span>
                            </div>
                            <MudProgressLinear Color="Color.Primary" Value="@_workerPct" Size="Size.Medium" Rounded="true" />
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-space-between align-center mb-1">
                                <span class="d-flex align-center">
                                    <MudIcon Icon="@Icons.Material.Filled.Storefront" Color="Color.Warning" Size="Size.Small" Class="mr-2" />
                                    <strong>Tiểu thương chợ & buôn bán nhỏ</strong>
                                </span>
                                <span><strong>@_merchantCount</strong> hồ sơ (@_merchantPct.ToString("0.0")%)</span>
                            </div>
                            <MudProgressLinear Color="Color.Warning" Value="@_merchantPct" Size="Size.Medium" Rounded="true" />
                        </div>

                        <div>
                            <div class="d-flex justify-space-between align-center mb-1">
                                <span class="d-flex align-center">
                                    <MudIcon Icon="@Icons.Material.Filled.Handyman" Color="Color.Info" Size="Size.Small" Class="mr-2" />
                                    <strong>Lao động tự do</strong>
                                </span>
                                <span><strong>@_freelanceCount</strong> hồ sơ (@_freelancePct.ToString("0.0")%)</span>
                            </div>
                            <MudProgressLinear Color="Color.Info" Value="@_freelancePct" Size="Size.Medium" Rounded="true" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudCard Elevation="2" Style="border-radius: 8px; height: 100%;">
                    <MudCardHeader>
                        <CardHeaderAvatar>
                            <MudAvatar Color="Color.Success" Size="Size.Small"><MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn" Size="Size.Small" /></MudAvatar>
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Class="font-weight-bold">Tình Trạng Hoạt Động & Hồ Sơ Vay</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Trạng thái phê duyệt và phục vụ trên toàn hệ thống</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="pt-0">
                        <div class="mb-4">
                            <div class="d-flex justify-space-between align-center mb-1">
                                <span class="d-flex align-center">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="mr-2" />
                                    <strong>Đang hoạt động (Đủ điều kiện vay)</strong>
                                </span>
                                <span><strong>@(_stats?.ActiveCustomers ?? 0)</strong> hồ sơ (@_activePct.ToString("0.0")%)</span>
                            </div>
                            <MudProgressLinear Color="Color.Success" Value="@_activePct" Size="Size.Medium" Rounded="true" />
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-space-between align-center mb-1">
                                <span class="d-flex align-center">
                                    <MudIcon Icon="@Icons.Material.Filled.PauseCircle" Color="Color.Warning" Size="Size.Small" Class="mr-2" />
                                    <strong>Tạm ngưng (Chờ tất toán / đối soát)</strong>
                                </span>
                                <span><strong>@(_stats?.SuspendedCustomers ?? 0)</strong> hồ sơ (@_suspendedPct.ToString("0.0")%)</span>
                            </div>
                            <MudProgressLinear Color="Color.Warning" Value="@_suspendedPct" Size="Size.Medium" Rounded="true" />
                        </div>

                        <div>
                            <div class="d-flex justify-space-between align-center mb-1">
                                <span class="d-flex align-center">
                                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" Class="mr-2" />
                                    <strong>Đã khóa (Vi phạm chính sách)</strong>
                                </span>
                                <span><strong>@(_stats?.LockedCustomers ?? 0)</strong> hồ sơ (@_lockedPct.ToString("0.0")%)</span>
                            </div>
                            <MudProgressLinear Color="Color.Error" Value="@_lockedPct" Size="Size.Medium" Rounded="true" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- 3. Bảng Top 5 Khách Hàng Mới Nhất -->
        <MudCard Elevation="2" Style="border-radius: 8px;">
            <MudCardHeader Class="d-flex justify-space-between align-center">
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Primary" Size="Size.Small"><MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" /></MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6" Class="font-weight-bold">Top 5 Khách Hàng Vừa Thêm Mới Gần Đây</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Hồ sơ khách hàng cập nhật mới nhất</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward" Href="/customers">
                        Xem Tất Cả Hồ Sơ
                    </MudButton>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent Class="pa-0">
                <MudTable Items="@_recentCustomers" Dense="true" Hover="true" Striped="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Mã KH</MudTh>
                        <MudTh>Họ và Tên</MudTh>
                        <MudTh>Số Điện Thoại</MudTh>
                        <MudTh>Phân Loại</MudTh>
                        <MudTh>Trạng Thái</MudTh>
                        <MudTh>Ngày Đăng Ký</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="item">
                        <MudTd><strong>@item.CustomerCode</strong></MudTd>
                        <MudTd>@item.FullName</MudTd>
                        <MudTd>@item.PhoneNumber</MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@GetSegmentColor(item.Segment)">
                                @GetSegmentName(item.Segment)
                            </MudChip>
                        </MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@GetStatusColor(item.Status)">
                                @GetStatusName(item.Status)
                            </MudChip>
                        </MudTd>
                        <MudTd>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudCardContent>
        </MudCard>
    </Authorized>
</AuthorizeView>

@code {
    private DashboardSummaryDto? _stats;
    private List<CustomerDto> _recentCustomers = [];

    private int _workerCount = 0;
    private int _merchantCount = 0;
    private int _freelanceCount = 0;

    private double _workerPct => (_workerCount + _merchantCount + _freelanceCount) > 0 ? (double)_workerCount * 100 / (_workerCount + _merchantCount + _freelanceCount) : 0;
    private double _merchantPct => (_workerCount + _merchantCount + _freelanceCount) > 0 ? (double)_merchantCount * 100 / (_workerCount + _merchantCount + _freelanceCount) : 0;
    private double _freelancePct => (_workerCount + _merchantCount + _freelanceCount) > 0 ? (double)_freelanceCount * 100 / (_workerCount + _merchantCount + _freelanceCount) : 0;

    private double _activePct => (_stats?.TotalCustomers ?? 0) > 0 ? (double)(_stats?.ActiveCustomers ?? 0) * 100 / _stats!.TotalCustomers : 0;
    private double _suspendedPct => (_stats?.TotalCustomers ?? 0) > 0 ? (double)(_stats?.SuspendedCustomers ?? 0) * 100 / _stats!.TotalCustomers : 0;
    private double _lockedPct => (_stats?.TotalCustomers ?? 0) > 0 ? (double)(_stats?.LockedCustomers ?? 0) * 100 / _stats!.TotalCustomers : 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var statsTask = ApiClient.GetDashboardStatsAsync();
            var allCustomersTask = ApiClient.GetCustomersAsync(new CustomerFilterDto { PageSize = 100 });
            var recentTask = ApiClient.GetCustomersAsync(new CustomerFilterDto { PageSize = 5 });

            await Task.WhenAll(statsTask, allCustomersTask, recentTask);

            var statsRes = await statsTask;
            if (statsRes.Success && statsRes.Data != null)
            {
                _stats = statsRes.Data;
            }

            var allCustomersRes = await allCustomersTask;
            if (allCustomersRes.Success && allCustomersRes.Data != null)
            {
                var list = allCustomersRes.Data.Items;
                _workerCount = list.Count(c => c.Segment == CustomerSegment.Worker);
                _merchantCount = list.Count(c => c.Segment == CustomerSegment.MicroMerchant);
                _freelanceCount = list.Count(c => c.Segment == CustomerSegment.Freelancer);
            }

            var recentRes = await recentTask;
            if (recentRes.Success && recentRes.Data != null)
            {
                _recentCustomers = recentRes.Data.Items;
            }
        }
        catch
        {
            // Gracefully ignore during initial rendering
        }
    }

    private static Color GetStatusColor(CustomerStatus status) => status switch
    {
        CustomerStatus.Active => Color.Success,
        CustomerStatus.Suspended => Color.Warning,
        CustomerStatus.Locked => Color.Error,
        _ => Color.Default
    };

    private static string GetStatusName(CustomerStatus status) => status switch
    {
        CustomerStatus.Active => "Đang hoạt động",
        CustomerStatus.Suspended => "Tạm ngưng",
        CustomerStatus.Locked => "Đã khóa",
        _ => "Không xác định"
    };

    private static Color GetSegmentColor(CustomerSegment segment) => segment switch
    {
        CustomerSegment.Worker => Color.Primary,
        CustomerSegment.MicroMerchant => Color.Warning,
        CustomerSegment.Freelancer => Color.Info,
        _ => Color.Default
    };

    private static string GetSegmentName(CustomerSegment segment) => segment switch
    {
        CustomerSegment.Worker => "Công nhân",
        CustomerSegment.MicroMerchant => "Tiểu thương",
        CustomerSegment.Freelancer => "Lao động tự do",
        _ => "Khác"
    };
}
