@page "/login"
@inject ICustomerApiClient ApiClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Đăng Nhập - CEP Microfinance CRM</PageTitle>

<div class="d-flex justify-center align-center" style="min-height: 80vh;">
    <MudCard Elevation="4" Style="max-width: 440px; width: 100%; border-radius: 12px;">
        <MudCardHeader Class="d-flex flex-column align-center text-center pb-2 pt-6">
            <MudAvatar Color="Color.Primary" Size="Size.Large" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Large" />
            </MudAvatar>
            <MudText Typo="Typo.h5" Color="Color.Primary" Class="font-weight-bold">CEP MICROFINANCE</MudText>
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Hệ Thống Quản Lý Khách Hàng Vi Mô</MudText>
        </MudCardHeader>

        <MudCardContent Class="px-6 py-4">
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">
                    @_errorMessage
                </MudAlert>
            }

            <MudForm @ref="_form" @bind-IsValid="@_isValid">
                <MudTextField @bind-Value="_model.Username" 
                              Label="Tên đăng nhập" 
                              Variant="Variant.Outlined" 
                              Required="true" 
                              RequiredError="Tên đăng nhập là bắt buộc" 
                              Adornment="Adornment.Start" 
                              AdornmentIcon="@Icons.Material.Filled.Person" 
                              Class="mb-3" />

                <MudTextField @bind-Value="_model.Password" 
                              Label="Mật khẩu" 
                              Variant="Variant.Outlined" 
                              InputType="@_passwordInputType" 
                              Required="true" 
                              RequiredError="Mật khẩu là bắt buộc" 
                              Adornment="Adornment.End" 
                              AdornmentIcon="@_passwordIcon" 
                              OnAdornmentClick="TogglePasswordVisibility" 
                              Class="mb-4" />

                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           FullWidth="true" 
                           Size="Size.Large" 
                           OnClick="HandleLogin" 
                           Disabled="@_isLoading" 
                           Class="py-3 font-weight-bold">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <span class="ms-2">Đang xác thực...</span>
                    }
                    else
                    {
                        <span>ĐĂNG NHẬP</span>
                    }
                </MudButton>
            </MudForm>

            <MudPaper Elevation="0" Class="pa-3 mt-4" Style="background-color: #E0F2F1; border-radius: 8px;">
                <MudText Typo="Typo.caption" Color="Color.Dark">
                    <strong>Tài khoản mặc định hệ thống:</strong><br />
                    • Tên đăng nhập: <code>admin</code><br />
                    • Mật khẩu: <code>Admin@123</code>
                </MudText>
            </MudPaper>
        </MudCardContent>
    </MudCard>
</div>

@code {
    private LoginDto _model = new();
    private MudForm _form = default!;
    private bool _isValid;
    private bool _isLoading;
    private string? _errorMessage;

    private bool _passwordVisible;
    private InputType _passwordInputType = InputType.Password;
    private string _passwordIcon = Icons.Material.Filled.VisibilityOff;

    private void TogglePasswordVisibility()
    {
        if (_passwordVisible)
        {
            _passwordVisible = false;
            _passwordIcon = Icons.Material.Filled.VisibilityOff;
            _passwordInputType = InputType.Password;
        }
        else
        {
            _passwordVisible = true;
            _passwordIcon = Icons.Material.Filled.Visibility;
            _passwordInputType = InputType.Text;
        }
    }

    private async Task HandleLogin()
    {
        await _form.ValidateAsync();
        if (!_isValid) return;

        _isLoading = true;
        _errorMessage = null;

        var result = await ApiClient.LoginAsync(_model);
        if (result.Success)
        {
            Snackbar.Add("Đăng nhập thành công! Chào mừng Quản Trị Viên CEP.", Severity.Success);
            Navigation.NavigateTo("/customers", forceLoad: true);
        }
        else
        {
            _errorMessage = result.Message;
        }

        _isLoading = false;
    }
}
