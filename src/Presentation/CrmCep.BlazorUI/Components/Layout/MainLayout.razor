@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject ICustomerApiClient ApiClient
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject IConfiguration Configuration

<MudThemeProvider Theme="_cepTheme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Medium" CloseButton="true" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="2" Color="Color.Primary" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Large" Class="mr-2 d-none d-sm-inline-flex" />
        <MudText Typo="Typo.h6" Class="font-weight-bold text-nowrap d-none d-sm-inline">CEP MICROFINANCE CRM</MudText>
        <MudText Typo="Typo.subtitle1" Class="font-weight-bold text-nowrap d-inline d-sm-none">CEP CRM</MudText>
        <MudSpacer />

        <AuthorizeView>
            <Authorized>
                <div class="d-none d-md-inline-flex">
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.VerifiedUser">
                        @context.User.Identity?.Name (Quản Trị Viên)
                    </MudChip>
                </div>
                <div class="d-none d-sm-inline-flex d-md-none">
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.VerifiedUser">
                        @context.User.Identity?.Name
                    </MudChip>
                </div>
                <MudTooltip Text="Chuyển đổi Sáng / Tối">
                    <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" 
                                   Color="Color.Inherit" OnClick="@(() => _isDarkMode = !_isDarkMode)" />
                </MudTooltip>
                <!-- Desktop Logout Button -->
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Logout" OnClick="HandleLogout" Class="d-none d-sm-inline-flex ml-2">
                    Đăng xuất
                </MudButton>
                <!-- Mobile Logout Icon Button -->
                <MudTooltip Text="Đăng xuất">
                    <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="HandleLogout" Class="d-inline-flex d-sm-none" />
                </MudTooltip>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Login" Href="/login">
                    Đăng nhập
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Breakpoint="Breakpoint.Md" Variant="DrawerVariant.Responsive">
        <MudDrawerHeader Class="d-flex d-md-none align-center justify-space-between px-4 py-2" Style="background-color: var(--mud-palette-primary); color: white;">
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Class="mr-2" />
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">CEP CRM</MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" Size="Size.Small" OnClick="@(() => _drawerOpen = false)" />
        </MudDrawerHeader>
        <MudNavMenu Class="pa-2">
            <MudText Typo="Typo.caption" Class="px-4 py-2 mud-text-secondary font-weight-bold">ĐIỀU HƯỚNG CHÍNH</MudText>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Tổng Quan CRM</MudNavLink>
            <MudNavLink Href="/customers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PeopleAlt">Quản Lý Khách Hàng</MudNavLink>
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.caption" Class="px-4 py-2 mud-text-secondary font-weight-bold">TÀI LIỆU DỰ ÁN</MudText>
            <MudNavLink Href="@_swaggerUrl" Target="_blank" Icon="@Icons.Material.Filled.Api">Swagger Web API</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="px-3 px-sm-4 px-md-6 pb-6" Style="background-color: var(--mud-palette-background-grey); min-height: 100vh; padding-top: calc(var(--mud-appbar-height) + 1.25rem) !important;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private string _swaggerUrl => $"{Configuration["WebApiBaseUrl"]?.TrimEnd('/') ?? "http://localhost:5034"}/swagger";

    private readonly MudTheme _cepTheme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#00695C",          // CEP Signature Teal Green
            Secondary = "#E65100",        // Deep Orange Accent
            AppbarBackground = "#004D40", // Deep Teal
            Background = "#F5F7FA",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            ActionDefault = "#00695C"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#26A69A",
            Secondary = "#FF9800",
            AppbarBackground = "#1A252C",
            Background = "#121A20",
            Surface = "#1E293B"
        }
    };

    private async Task HandleLogout()
    {
        await ApiClient.LogoutAsync();
        Snackbar.Add("Đã đăng xuất khỏi hệ thống thành công.", Severity.Info);
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
