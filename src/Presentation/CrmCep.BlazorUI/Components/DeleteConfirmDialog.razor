@inject ICustomerApiClient ApiClient
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Class="mr-2" />
            <MudText Typo="Typo.h6" Color="Color.Error">XÁC NHẬN XÓA KHÁCH HÀNG</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-2">
            Bạn có chắc chắn muốn xóa khách hàng <strong>@CustomerName</strong> (Mã: <code>@CustomerCode</code>) không?
        </MudText>
        <MudAlert Severity="Severity.Warning" Dense="true" Class="my-2">
            <strong>Lưu ý:</strong> Hệ thống áp dụng cơ chế <em>Soft Delete (Xóa mềm)</em> để bảo toàn lịch sử giao dịch và số liệu kế toán của CEP.
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Hủy Bỏ</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Submit" Disabled="@_isDeleting">
            @if (_isDeleting)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <span class="ms-2">Đang xóa...</span>
            }
            else
            {
                <span>Đồng Ý Xóa</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Guid CustomerId { get; set; }

    [Parameter]
    public string CustomerCode { get; set; } = string.Empty;

    [Parameter]
    public string CustomerName { get; set; } = string.Empty;

    private bool _isDeleting;

    private async Task Submit()
    {
        _isDeleting = true;
        var response = await ApiClient.DeleteCustomerAsync(CustomerId);
        if (response.Success)
        {
            Snackbar.Add($"Đã xóa khách hàng '{CustomerName}' thành công.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add(response.Message, Severity.Error);
        }
        _isDeleting = false;
    }

    private void Cancel() => MudDialog.Cancel();
}
